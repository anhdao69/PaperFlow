{% extends "base.html.j2" %}
{% block content %}
{% if section_links %}
  <nav class="section-nav" aria-label="Subtopics">
    {% for link in section_links %}<a href="{{ link.href }}">{{ link.name }} · {{ link.count }}</a>{% endfor %}
  </nav>
{% endif %}
{% if days %}
  <div class="day-list">
  {% for day in days %}
    <section class="day-section" aria-labelledby="day-{{ day.date }}">
      <div class="day-heading">
        <div>
          <p class="eyebrow">{{ day.date }}</p>
          <h2 id="day-{{ day.date }}"><a href="{{ day.href }}">{{ day.label }}</a></h2>
        </div>
        <span class="count">{{ day.paper_count }} {{ "paper" if day.paper_count == 1 else "papers" }}</span>
      </div>
      {% if day.papers %}
      <div class="paper-grid">
        {% for item in day.papers %}{% include "paper_card.html.j2" %}{% endfor %}
      </div>
      {% else %}
      <div class="empty-state">No papers matched the configured research interests on this successful feed day.</div>
      {% endif %}
    </section>
  {% endfor %}
  </div>
{% else %}
  <section class="empty-state">No matching papers yet.</section>
{% endif %}
{% endblock %}
