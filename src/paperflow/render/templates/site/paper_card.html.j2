<article class="paper-card" data-arxiv-id="{{ item.paper.arxiv_id }}">
  <div class="figure-shell figure-{{ item.paper.figure_status.value }}">
    {% if item.hero_src %}
    <img src="{{ item.hero_src }}" alt="Figure from {{ item.paper.title }}" loading="lazy">
    {% else %}
    <span aria-hidden="true">⌁</span>
    <small>{{ item.figure_label }}</small>
    {% endif %}
  </div>
  <div class="paper-body">
    <div class="paper-meta">
      <span>arXiv {{ item.paper.arxiv_id }}</span>
      <span>Rel. {{ item.paper.relevance }} · Nov. {{ item.paper.novelty }}</span>
    </div>
    <h3><a href="{{ item.paper.arxiv_url }}">{{ item.paper.title }}</a></h3>
    <p class="authors">{{ item.paper.authors | join(", ") }}</p>
    <p class="summary{% if item.uses_fallback %} fallback{% endif %}">{{ item.paper.display_summary }}</p>
    <ul class="topic-chips" aria-label="Topics">
      {% for label in item.topic_labels %}<li>{{ label }}</li>{% endfor %}
    </ul>
    <div class="paper-actions">
      <a href="{{ item.paper.arxiv_url }}">Abstract</a>
      <a href="{{ item.paper.pdf_url }}">PDF</a>
    </div>
  </div>
</article>
